{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://preview--belote-bridge-battle.lovable.app"
    ]
  },
  "Games": {
    "MaximumActive": 500
  },
  "TeamMatch": {
    "Automation": {
      "MaximumActiveMatches": 20,
      "WakeupQueueCapacity": 64,
      "ActionsPerCycle": 8,
      "IdleScanMilliseconds": 250,
      "InterActionDelayMilliseconds": 1,
      "MaximumDecisionRetries": 3,
      "RetryDelayMilliseconds": 250
    }
  },
  "Debug": {
    "RevealHandsEnabled": false
  },
  "RateLimit": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "Hybrid": {
      "Enabled": false,
      "IpPermitLimit": 600,
      "WindowSeconds": 60,
      "TeamMatchReadPermitLimit": 90,
      "TeamMatchMutationPermitLimit": 20,
      "PerUserConcurrencyLimit": 4,
      "AggregateConcurrencyLimit": 32
    }
  },
  "AllowedHosts": "*"
}
