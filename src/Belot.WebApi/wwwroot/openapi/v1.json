{
  "openapi": "3.0.3",
  "info": {
    "title": "Belot Game API",
    "version": "v1",
    "description": "Play a solo match against the original BelotGameEngine bots or create a private multiplayer lobby. Multiplayer lobby and game routes require a Supabase access token. Realtime notifications use the authenticated SignalR hub at /hubs/multiplayer; see MULTIPLAYER_A06.md for its subscription and event contract. REST remains authoritative for actions and private seat snapshots. All JSON property names are camelCase."
  },
  "servers": [
    {
      "url": "https://belotgameengine.onrender.com"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check API health",
        "responses": {
          "200": {
            "description": "API is available.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": { "status": "ok" }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/bots": {
      "get": {
        "operationId": "getBots",
        "summary": "List supported bot profiles",
        "responses": {
          "200": {
            "description": "Available profiles. These are the existing original bot implementations.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/BotProfile" }
                },
                "example": [
                  { "id": "random", "name": "Random" },
                  { "id": "beginner", "name": "Beginner" },
                  { "id": "skilled", "name": "Skilled" },
                  { "id": "expert", "name": "Expert" },
                  { "id": "master", "name": "Master" }
                ]
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/games": {
      "post": {
        "operationId": "createGame",
        "summary": "Start a match",
        "description": "Creates a match with the human at South. Each bot profile defaults to skilled. The response is the initial South-visible state; the gameId acts as a bearer token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateGameRequest" },
              "example": { "north": "beginner", "east": "expert", "west": "master" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Match created. The Location header identifies the game resource.",
            "headers": {
              "Location": {
                "schema": { "type": "string" },
                "description": "Relative URL of the created game."
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GameState" }
              }
            }
          },
          "400": {
            "description": "One or more bot profile IDs are not supported.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "error": "north, east and west must be valid bot profile ids." }
              }
            }
          },
          "503": { "$ref": "#/components/responses/Unavailable" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/games/{gameId}": {
      "parameters": [
        {
          "name": "gameId",
          "in": "path",
          "required": true,
          "schema": { "type": "string" },
          "description": "Opaque game ID returned by POST /api/games."
        }
      ],
      "get": {
        "operationId": "getGame",
        "summary": "Get the current game state",
        "description": "Returns only the South player's legal, visible information; opponents' hands are never included.",
        "responses": {
          "200": {
            "description": "Current South-visible state.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GameState" }
              }
            }
          },
          "404": {
            "description": "No active game has this ID.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "error": "Game not found." }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/games/{gameId}/actions": {
      "parameters": [
        {
          "name": "gameId",
          "in": "path",
          "required": true,
          "schema": { "type": "string" },
          "description": "Opaque game ID returned by POST /api/games."
        }
      ],
      "post": {
        "operationId": "submitGameAction",
        "summary": "Submit South's current action",
        "description": "Send the field matching the current state's decision. Use availableBids, availableAnnounces, playableCards and beloteCards from that state. Successful actions run all intervening bot moves and return the updated state plus ordered public events.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GameActionRequest" },
              "examples": {
                "bid": { "value": { "bid": "Clubs" } },
                "pass": { "value": { "bid": "Pass" } },
                "declare": {
                  "value": {
                    "announces": [
                      { "type": "SequenceOf3", "card": { "suit": "Heart", "type": "Jack" } }
                    ]
                  }
                },
                "declareNone": { "value": { "announces": [] } },
                "playCard": {
                  "value": {
                    "card": { "suit": "Heart", "type": "Ace" },
                    "belote": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Action accepted; bots have acted until South must decide again or the match ends.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GameActionResponse" }
              }
            }
          },
          "400": {
            "description": "Malformed or unavailable action for the current decision.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "examples": {
                  "invalidAction": { "value": { "error": "bid must be one available bid name." } },
                  "invalidCard": { "value": { "error": "card must contain a valid suit and type." } }
                }
              }
            }
          },
          "404": {
            "description": "No active game has this ID.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "error": "Game not found." }
              }
            }
          },
          "409": {
            "description": "The match is finished or South is not currently to move.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "examples": {
                  "finished": { "value": { "error": "The match is finished." } },
                  "notSouthTurn": { "value": { "error": "The human seat is not currently to move." } }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/multiplayer/games/{gameId}": {
      "parameters": [
        {
          "name": "gameId",
          "in": "path",
          "required": true,
          "schema": { "type": "string" },
          "description": "Opaque lobby/game ID returned when the host starts the lobby."
        }
      ],
      "get": {
        "operationId": "getMultiplayerGame",
        "summary": "Get a private multiplayer game snapshot",
        "description": "Returns the current revision, public match state and only the authenticated member's seat view. Game state is process-local and unavailable after an API restart.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The caller's current seat-scoped snapshot.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MultiplayerGameSnapshot" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/MultiplayerGameConflict" },
          "410": { "$ref": "#/components/responses/MultiplayerGameUnavailable" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/multiplayer/games/{gameId}/actions": {
      "parameters": [
        {
          "name": "gameId",
          "in": "path",
          "required": true,
          "schema": { "type": "string" },
          "description": "Opaque lobby/game ID returned when the host starts the lobby."
        }
      ],
      "post": {
        "operationId": "submitMultiplayerGameAction",
        "summary": "Submit a revision-checked multiplayer action",
        "description": "The authenticated member's seat is derived from membership, never from the request. Reuse the same idempotencyKey and request body for retries. Each accepted human action advances revision once; automatic bot actions are included in its response.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MultiplayerGameActionRequest" },
              "examples": {
                "bid": { "value": { "expectedRevision": 0, "idempotencyKey": "turn-1", "bid": "Clubs" } },
                "playCard": {
                  "value": {
                    "expectedRevision": 12,
                    "idempotencyKey": "turn-13",
                    "card": { "suit": "Heart", "type": "Ace" },
                    "belote": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The accepted action, updated caller-visible state and ordered public events.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MultiplayerGameActionResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidMultiplayerGameAction" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/MultiplayerGameConflict" },
          "410": { "$ref": "#/components/responses/MultiplayerGameUnavailable" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/MultiplayerGameServiceUnavailable" }
        }
      }
    },
    "/api/multiplayer/games/{gameId}/automation/resume": {
      "parameters": [
        {
          "name": "gameId",
          "in": "path",
          "required": true,
          "schema": { "type": "string" },
          "description": "Opaque lobby/game ID returned when the host starts the lobby."
        }
      ],
      "post": {
        "operationId": "resumeMultiplayerAutomation",
        "summary": "Resume pending automatic game actions",
        "description": "Any authenticated room member may request bounded recovery after a bot failure, including when the original submitting member disconnects. This route does not replay the human action or return a private seat snapshot.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Automatic actions are complete, or no bot action was pending.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MultiplayerAutomationResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/MultiplayerGameConflict" },
          "410": { "$ref": "#/components/responses/MultiplayerGameUnavailable" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/MultiplayerGameServiceUnavailable" }
        }
      }
    },
    "/api/multiplayer/lobbies": {
      "post": {
        "operationId": "createMultiplayerLobby",
        "summary": "Create a private multiplayer lobby",
        "description": "Creates a lobby with the authenticated user at South. The invitation code is returned only in this response; share it privately with invitees.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMultiplayerRoomRequest"
              },
              "example": {
                "maximumHumanPlayers": 4,
                "eastBot": "random",
                "northBot": "expert",
                "westBot": "master"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lobby created; the Location header identifies the member-only lobby resource.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Relative URL of the created lobby."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateMultiplayerRoomResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidLobbyRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/multiplayer/lobbies/{roomId}": {
      "parameters": [
        {
          "name": "roomId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Opaque lobby ID returned by POST /api/multiplayer/lobbies."
        }
      ],
      "get": {
        "operationId": "getMultiplayerLobby",
        "summary": "Read a lobby as a member",
        "description": "Returns public seat occupancy and readiness, plus the authenticated member's own absolute seat. Re-authenticate and fetch this resource to reconnect; the invitation code is never returned.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current lobby state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MultiplayerRoom"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/multiplayer/lobbies/{roomId}/join": {
      "parameters": [
        {
          "name": "roomId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Opaque lobby ID returned by POST /api/multiplayer/lobbies."
        }
      ],
      "post": {
        "operationId": "joinMultiplayerLobby",
        "summary": "Join a private lobby",
        "description": "Claims the requested free absolute seat for the authenticated user. Requires the private invitation code; user IDs and seat ownership are derived and enforced by the server.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinMultiplayerRoomRequest"
              },
              "example": {
                "invitationCode": "one-time-secret",
                "seat": "East"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lobby after the seat claim.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MultiplayerRoom"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidLobbyRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/LobbyConflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/multiplayer/lobbies/{roomId}/ready": {
      "parameters": [
        {
          "name": "roomId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Opaque lobby ID returned by POST /api/multiplayer/lobbies."
        }
      ],
      "post": {
        "operationId": "setMultiplayerLobbyReady",
        "summary": "Set the authenticated member's ready state",
        "description": "A member may mark themselves ready or not ready while the lobby is waiting for players.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetMultiplayerReadyRequest"
              },
              "example": {
                "isReady": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lobby after the readiness change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MultiplayerRoom"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/LobbyConflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/multiplayer/lobbies/{roomId}/start": {
      "parameters": [
        {
          "name": "roomId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Opaque lobby ID returned by POST /api/multiplayer/lobbies."
        }
      ],
      "post": {
        "operationId": "startMultiplayerLobby",
        "summary": "Start the lobby as its host",
        "description": "Requires at least two human members and readiness from every joined member. All remaining seats are assigned the host-selected bot profiles. The match is held in process memory and cannot be restored after an API restart.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Started lobby with all seats assigned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MultiplayerRoom"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/LobbyConflict"
          },
          "503": {
            "$ref": "#/components/responses/MultiplayerGameCapacity"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase Auth access token."
      }
    },
    "responses": {
      "RateLimited": {
        "description": "The per-IP request limit has been reached. The API returns an empty 429 response."
      },
      "Unavailable": {
        "description": "The API cannot create a game because its active-game capacity has been reached. The response has no body."
      },
      "InvalidLobbyRequest": {
        "description": "The lobby settings, selected seat, invitation code or ready request is invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "The request does not contain a valid Supabase access token."
      },
      "Forbidden": {
        "description": "The caller is not a lobby member, is not the host, or supplied an invalid invitation code."
      },
      "NotFound": {
        "description": "No lobby exists with this ID.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "LobbyConflict": {
        "description": "The seat is occupied, the lobby is full or started, the caller already has a seat, or start requirements are not met.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "MultiplayerGameConflict": {
        "description": "The lobby is not initialized, the match is finished, it is not the caller's turn, or expectedRevision is stale. currentRevision is returned when known.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MultiplayerGameError" },
            "example": { "error": "The game revision is stale; read the current seat snapshot before acting.", "currentRevision": 13 }
          }
        }
      },
      "MultiplayerGameUnavailable": {
        "description": "The process-local match is unavailable after a restart or its completed-game retention period.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MultiplayerGameError" },
            "example": { "error": "The in-memory match is unavailable after a process restart.", "currentRevision": null }
          }
        }
      },
      "InvalidMultiplayerGameAction": {
        "description": "The action body is malformed, the idempotency key is invalid, or the action is illegal for the current decision. currentRevision is returned when known.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MultiplayerGameError" },
            "example": { "error": "Provide a non-negative expectedRevision and an idempotencyKey of 1 to 128 characters.", "currentRevision": 13 }
          }
        }
      },
      "MultiplayerGameServiceUnavailable": {
        "description": "A bot failed to decide or bounded automatic processing remains pending. An action response includes the advanced currentRevision; retry the identical action with the same idempotencyKey, or let any room member call the automation/resume route.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MultiplayerGameError" },
            "example": { "error": "The human action was accepted, but an automatic player could not decide. Retry the same idempotency key to continue.", "currentRevision": 14 }
          }
        }
      },
      "MultiplayerGameCapacity": {
        "description": "The process-local active-game capacity is full. Active matches are not evicted; retry after a completed game expires.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MultiplayerGameError" }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "example": "ok" }
        }
      },
      "BotProfile": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "enum": ["random", "beginner", "skilled", "expert", "master"] },
          "name": { "type": "string", "example": "Skilled" }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },
      "MultiplayerGameError": {
        "type": "object",
        "required": ["error", "currentRevision"],
        "properties": {
          "error": { "type": "string" },
          "currentRevision": { "type": "integer", "format": "int64", "minimum": 0, "nullable": true }
        }
      },
      "MultiplayerGameSnapshot": {
        "type": "object",
        "required": ["gameId", "revision", "yourSeat", "state", "lastEventSequence"],
        "properties": {
          "gameId": { "type": "string" },
          "revision": { "type": "integer", "format": "int64", "minimum": 0 },
          "yourSeat": { "type": "string", "enum": ["South", "East", "North", "West"] },
          "state": { "$ref": "#/components/schemas/GameState" },
          "lastEventSequence": {
            "type": "integer",
            "minimum": -1,
            "description": "Sequence cursor supplied to JoinGame. A value of -1 means no sequence is available from the current in-memory journal; the REST state remains authoritative."
          }
        }
      },
      "MultiplayerGameActionRequest": {
        "type": "object",
        "required": ["expectedRevision", "idempotencyKey"],
        "description": "Provide only the action field appropriate to the current decision. Reuse the complete request unchanged when retrying.",
        "properties": {
          "expectedRevision": { "type": "integer", "format": "int64", "minimum": 0 },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Client-generated key bound to this authenticated user and exact request."
          },
          "bid": {
            "type": "string",
            "enum": ["Pass", "Clubs", "Diamonds", "Hearts", "Spades", "NoTrumps", "AllTrumps", "Double", "ReDouble"]
          },
          "announces": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AnnounceRequest" },
            "description": "Selected offered declarations, or an empty array."
          },
          "card": { "$ref": "#/components/schemas/Card" },
          "belote": { "type": "boolean", "default": false }
        }
      },
      "MultiplayerGameActionResponse": {
        "type": "object",
        "required": ["revision", "yourSeat", "state", "events"],
        "properties": {
          "revision": { "type": "integer", "format": "int64", "minimum": 1 },
          "yourSeat": { "type": "string", "enum": ["South", "East", "North", "West"] },
          "state": { "$ref": "#/components/schemas/GameState" },
          "events": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PublicGameEvent" },
            "description": "Ordered public events produced by the accepted human action and any automatic bot actions."
          }
        }
      },
      "MultiplayerAutomationResponse": {
        "type": "object",
        "required": ["revision", "automationPending"],
        "properties": {
          "revision": { "type": "integer", "format": "int64", "minimum": 0 },
          "automationPending": {
            "type": "boolean",
            "description": "False when the request completed successfully; an incomplete recovery is returned as HTTP 503."
          }
        }
      },
      "CreateMultiplayerRoomRequest": {
        "type": "object",
        "properties": {
          "maximumHumanPlayers": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4,
            "default": 4
          },
          "eastBot": {
            "type": "string",
            "enum": [
              "random",
              "beginner",
              "skilled",
              "expert",
              "master"
            ],
            "default": "skilled"
          },
          "northBot": {
            "type": "string",
            "enum": [
              "random",
              "beginner",
              "skilled",
              "expert",
              "master"
            ],
            "default": "skilled"
          },
          "westBot": {
            "type": "string",
            "enum": [
              "random",
              "beginner",
              "skilled",
              "expert",
              "master"
            ],
            "default": "skilled"
          }
        }
      },
      "CreateMultiplayerRoomResponse": {
        "type": "object",
        "required": [
          "room",
          "invitationCode"
        ],
        "properties": {
          "room": {
            "$ref": "#/components/schemas/MultiplayerRoom"
          },
          "invitationCode": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "description": "One-time private invitation secret. The API stores only its SHA-256 hash."
          }
        }
      },
      "JoinMultiplayerRoomRequest": {
        "type": "object",
        "required": [
          "invitationCode",
          "seat"
        ],
        "properties": {
          "invitationCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "seat": {
            "type": "string",
            "enum": [
              "East",
              "North",
              "West"
            ],
            "description": "Absolute engine seat requested by this authenticated user."
          }
        }
      },
      "SetMultiplayerReadyRequest": {
        "type": "object",
        "required": [
          "isReady"
        ],
        "properties": {
          "isReady": {
            "type": "boolean"
          }
        }
      },
      "MultiplayerRoom": {
        "type": "object",
        "required": [
          "roomId",
          "status",
          "createdAt",
          "yourSeat",
          "humanPlayerCount",
          "maximumHumanPlayers",
          "seats",
          "eventRevision",
          "eventSequence"
        ],
        "properties": {
          "roomId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "WaitingForPlayers",
              "Starting",
              "Started"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "yourSeat": {
            "type": "string",
            "enum": [
              "South",
              "East",
              "North",
              "West"
            ]
          },
          "humanPlayerCount": {
            "type": "integer"
          },
          "maximumHumanPlayers": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4
          },
          "seats": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/MultiplayerSeat"
            }
          },
          "eventRevision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Lobby event cursor captured atomically with this room snapshot. Lobby revisions are process-wide and may skip values due to events in other rooms."
          },
          "eventSequence": {
            "type": "integer",
            "minimum": -1,
            "description": "Sequence at eventRevision; lobby events currently use 0 and -1 denotes a snapshot baseline before the next event."
          }
        }
      },
      "MultiplayerSeat": {
        "type": "object",
        "required": [
          "seat",
          "team",
          "isOccupied",
          "isHost",
          "isReady",
          "botProfileId"
        ],
        "properties": {
          "seat": {
            "type": "string",
            "enum": [
              "South",
              "East",
              "North",
              "West"
            ]
          },
          "team": {
            "type": "string",
            "enum": [
              "SouthNorth",
              "EastWest"
            ]
          },
          "isOccupied": {
            "type": "boolean",
            "description": "True for a human or, after start, a bot."
          },
          "isHost": {
            "type": "boolean"
          },
          "isReady": {
            "type": "boolean",
            "description": "Readiness of the human owner; false for bot and vacant seats."
          },
          "botProfileId": {
            "type": "string",
            "enum": [
              "random",
              "beginner",
              "skilled",
              "expert",
              "master"
            ],
            "nullable": true,
            "description": "Selected bot profile for a vacant seat or assigned bot."
          }
        }
      },
      "CreateGameRequest": {
        "type": "object",
        "properties": {
          "north": { "type": "string", "enum": ["random", "beginner", "skilled", "expert", "master"], "default": "skilled" },
          "east": { "type": "string", "enum": ["random", "beginner", "skilled", "expert", "master"], "default": "skilled" },
          "west": { "type": "string", "enum": ["random", "beginner", "skilled", "expert", "master"], "default": "skilled" }
        }
      },
      "GameActionRequest": {
        "type": "object",
        "description": "The DTO accepts these optional fields; semantically supply the field appropriate to the current decision. A bid may be Pass, Clubs, Diamonds, Hearts, Spades, NoTrumps, AllTrumps, Double or ReDouble, subject to availableBids.",
        "properties": {
          "bid": {
            "type": "string",
            "enum": ["Pass", "Clubs", "Diamonds", "Hearts", "Spades", "NoTrumps", "AllTrumps", "Double", "ReDouble"],
            "description": "One available bid. For a Bid decision, send for example {\"bid\":\"Clubs\"}."
          },
          "announces": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AnnounceRequest" },
            "description": "For an Announce decision, send selected offered declarations, or [] to declare none."
          },
          "card": {
            "allOf": [{ "$ref": "#/components/schemas/Card" }],
            "description": "For a PlayCard decision, one card from playableCards."
          },
          "belote": {
            "type": "boolean",
            "default": false,
            "description": "Set true only when the selected card is listed in beloteCards."
          }
        }
      },
      "AnnounceRequest": {
        "type": "object",
        "required": ["type", "card"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["Belot", "SequenceOf3", "SequenceOf4", "SequenceOf5", "SequenceOf6", "SequenceOf7", "SequenceOf8", "FourOfAKind", "FourNines", "FourJacks"]
          },
          "card": { "$ref": "#/components/schemas/Card" }
        },
        "description": "Select an offered declaration using its type and card from availableAnnounces."
      },
      "Card": {
        "type": "object",
        "required": ["suit", "type"],
        "properties": {
          "suit": { "type": "string", "enum": ["Club", "Diamond", "Heart", "Spade"] },
          "type": { "type": "string", "enum": ["Seven", "Eight", "Nine", "Ten", "Jack", "Queen", "King", "Ace"] }
        },
        "description": "A card is identified by the singular enum names suit and type, for example {\"suit\":\"Heart\",\"type\":\"Ace\"}."
      },
      "Bid": {
        "type": "object",
        "required": ["seat", "type"],
        "properties": {
          "seat": { "type": "string", "enum": ["South", "East", "North", "West"] },
          "type": {
            "type": "string",
            "description": "A bid name. Contract types can include comma-separated flags such as Double or ReDouble.",
            "example": "Clubs"
          }
        }
      },
      "Announce": {
        "type": "object",
        "required": ["seat", "type", "card", "isScored"],
        "properties": {
          "seat": { "type": "string", "enum": ["South", "East", "North", "West"] },
          "type": { "type": "string", "enum": ["Belot", "SequenceOf3", "SequenceOf4", "SequenceOf5", "SequenceOf6", "SequenceOf7", "SequenceOf8", "FourOfAKind", "FourNines", "FourJacks"] },
          "card": { "allOf": [{ "$ref": "#/components/schemas/Card" }], "nullable": true },
          "isScored": { "type": "boolean", "nullable": true }
        }
      },
      "PlayedCard": {
        "type": "object",
        "required": ["seat", "card", "belote"],
        "properties": {
          "seat": { "type": "string", "enum": ["South", "East", "North", "West"] },
          "card": { "$ref": "#/components/schemas/Card" },
          "belote": { "type": "boolean" }
        }
      },
      "Trick": {
        "type": "object",
        "required": ["cards", "winner"],
        "properties": {
          "cards": { "type": "array", "items": { "$ref": "#/components/schemas/PlayedCard" } },
          "winner": { "type": "string", "enum": ["South", "East", "North", "West"] }
        }
      },
      "RoundSummary": {
        "type": "object",
        "required": ["roundNumber", "contract", "southNorthPoints", "eastWestPoints", "southNorthTotalInRoundPoints", "eastWestTotalInRoundPoints", "hangingPoints", "bids", "announces", "tricks"],
        "properties": {
          "roundNumber": { "type": "integer" },
          "contract": { "$ref": "#/components/schemas/Bid" },
          "southNorthPoints": { "type": "integer" },
          "eastWestPoints": { "type": "integer" },
          "southNorthTotalInRoundPoints": { "type": "integer" },
          "eastWestTotalInRoundPoints": { "type": "integer" },
          "hangingPoints": { "type": "integer" },
          "bids": { "type": "array", "items": { "$ref": "#/components/schemas/Bid" } },
          "announces": { "type": "array", "items": { "$ref": "#/components/schemas/Announce" } },
          "tricks": { "type": "array", "items": { "$ref": "#/components/schemas/Trick" } }
        }
      },
      "GameState": {
        "type": "object",
        "required": ["gameId", "bots", "isFinished", "winner", "toMove", "decision", "roundNumber", "firstToPlay", "southNorthPoints", "eastWestPoints", "hangingPoints", "contract", "bids", "announces", "tricks", "currentTrick", "cardCounts", "hand", "availableBids", "availableAnnounces", "playableCards", "beloteCards", "previousRounds"],
        "properties": {
          "gameId": { "type": "string", "description": "Opaque ID for the in-memory game; solo routes also use it as a bearer token." },
          "bots": { "type": "object", "additionalProperties": { "type": "string", "enum": ["random", "beginner", "skilled", "expert", "master"] }, "example": { "North": "skilled", "East": "skilled", "West": "skilled" } },
          "isFinished": { "type": "boolean" },
          "winner": { "type": "string", "enum": ["SouthNorthTeam", "EastWestTeam"], "nullable": true },
          "toMove": { "type": "string", "enum": ["South", "East", "North", "West", "Unknown"] },
          "decision": { "type": "string", "enum": ["None", "Bid", "Announce", "PlayCard"] },
          "roundNumber": { "type": "integer" },
          "firstToPlay": { "type": "string", "enum": ["South", "East", "North", "West"] },
          "southNorthPoints": { "type": "integer" },
          "eastWestPoints": { "type": "integer" },
          "hangingPoints": { "type": "integer" },
          "contract": { "$ref": "#/components/schemas/Bid" },
          "bids": { "type": "array", "items": { "$ref": "#/components/schemas/Bid" } },
          "announces": { "type": "array", "items": { "$ref": "#/components/schemas/Announce" } },
          "tricks": { "type": "array", "items": { "$ref": "#/components/schemas/Trick" } },
          "currentTrick": { "type": "array", "items": { "$ref": "#/components/schemas/PlayedCard" } },
          "cardCounts": { "type": "array", "items": { "type": "integer" }, "description": "Card counts in engine seat order: South, East, North, West." },
          "hand": { "type": "array", "items": { "$ref": "#/components/schemas/Card" }, "description": "Only the requesting seat's hand (South for solo routes)." },
          "availableBids": { "type": "array", "items": { "type": "string", "enum": ["Pass", "Clubs", "Diamonds", "Hearts", "Spades", "NoTrumps", "AllTrumps", "Double", "ReDouble"] } },
          "availableAnnounces": { "type": "array", "items": { "$ref": "#/components/schemas/Announce" } },
          "playableCards": { "type": "array", "items": { "$ref": "#/components/schemas/Card" } },
          "beloteCards": { "type": "array", "items": { "$ref": "#/components/schemas/Card" } },
          "previousRounds": { "type": "array", "items": { "$ref": "#/components/schemas/RoundSummary" } }
        }
      },
      "PublicGameEvent": {
        "type": "object",
        "required": ["sequence", "type", "roundNumber", "seat", "bid", "contractSeat", "contract", "automatic", "card", "belote", "trickNumber", "cards", "winner", "announces", "southNorthPoints", "eastWestPoints", "southNorthTotalInRoundPoints", "eastWestTotalInRoundPoints", "hangingPoints", "matchFinished"],
        "properties": {
          "sequence": { "type": "integer" },
          "type": { "type": "string", "enum": ["bid", "contract", "declarations", "card", "trick", "deal-ended", "deal-started"] },
          "roundNumber": { "type": "integer" },
          "seat": { "type": "string", "enum": ["South", "East", "North", "West"], "nullable": true },
          "bid": { "type": "string", "nullable": true },
          "contractSeat": { "type": "string", "enum": ["South", "East", "North", "West"], "nullable": true },
          "contract": { "type": "string", "nullable": true },
          "automatic": { "type": "boolean", "nullable": true },
          "card": { "allOf": [{ "$ref": "#/components/schemas/Card" }], "nullable": true },
          "belote": { "type": "boolean", "nullable": true },
          "trickNumber": { "type": "integer", "nullable": true },
          "cards": { "type": "array", "items": { "$ref": "#/components/schemas/PlayedCard" }, "nullable": true },
          "winner": { "type": "string", "enum": ["South", "East", "North", "West"], "nullable": true },
          "announces": { "type": "array", "items": { "$ref": "#/components/schemas/Announce" }, "nullable": true },
          "southNorthPoints": { "type": "integer", "nullable": true },
          "eastWestPoints": { "type": "integer", "nullable": true },
          "southNorthTotalInRoundPoints": { "type": "integer", "nullable": true },
          "eastWestTotalInRoundPoints": { "type": "integer", "nullable": true },
          "hangingPoints": { "type": "integer", "nullable": true },
          "matchFinished": { "type": "boolean", "nullable": true }
        }
      },
      "GameActionResponse": {
        "type": "object",
        "required": ["state", "events"],
        "properties": {
          "state": { "$ref": "#/components/schemas/GameState" },
          "events": { "type": "array", "items": { "$ref": "#/components/schemas/PublicGameEvent" } }
        }
      }
    }
  }
}
